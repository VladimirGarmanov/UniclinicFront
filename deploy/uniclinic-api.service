[Unit]
Description=Uniclinic private submissions API
After=network.target
[Service]
Type=simple
User=uniclinic
Group=uniclinic
WorkingDirectory=/srv/uniclinic/current/backend
EnvironmentFile=/etc/uniclinic/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/uniclinic/current/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uniclinic
[Install]
WantedBy=multi-user.target
